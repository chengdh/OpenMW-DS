+    // CJK fix: scripts that do not separate words with spaces must be allowed to break a
+    // line between two characters. These ranges cover the ideographic scripts: CJK radicals
+    // through Yi, kana, Hangul, compatibility ideographs, fullwidth forms and the SMP
+    // ideograph planes. Latin, Cyrillic, Greek and friends stay out, so ordinary prose keeps
+    // breaking at word boundaries exactly as before.
+    bool ucsCjk(Utf8Stream::UnicodeChar codePoint)
+    {
+        return (codePoint >= 0x1100 && codePoint <= 0x115F)      // Hangul Jamo
+            || (codePoint >= 0x2E80 && codePoint <= 0xA4CF)      // CJK radicals, kana, ideographs, Yi
+            || (codePoint >= 0xAC00 && codePoint <= 0xD7A3)      // Hangul syllables
+            || (codePoint >= 0xF900 && codePoint <= 0xFAFF)      // CJK compatibility ideographs
+            || (codePoint >= 0xFE30 && codePoint <= 0xFE6F)      // CJK compatibility forms
+            || (codePoint >= 0xFF00 && codePoint <= 0xFF60)      // fullwidth forms
+            || (codePoint >= 0xFFE0 && codePoint <= 0xFFE6)      // fullwidth signs
+            || (codePoint >= 0x20000 && codePoint <= 0x3FFFD);   // ideograph extensions
+    }
