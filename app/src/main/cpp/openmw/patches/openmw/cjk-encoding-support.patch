+    // Copy the bytes through untouched: wrong glyphs, but no crash and no
+    // dependency. Used when no converter is available.
+    std::size_t copyRaw(std::string_view input, BufferAllocationPolicy bufferAllocationPolicy,
+        std::string& buffer)
+    {
+        resize(input.size() + 1, bufferAllocationPolicy, buffer);
+        std::memcpy(buffer.data(), input.data(), input.size());
+        buffer[input.size()] = 0;
