+#if defined(OPENMW_CJK_HAVE_ICONV)
+    long convertWithIconv(const char* toCode, const char* fromCode, std::string_view input,
+        BufferAllocationPolicy bufferAllocationPolicy, std::string& buffer, std::size_t bytesPerChar)
+    {
+        iconv_t cd = iconv_open(toCode, fromCode);
+        if (cd == reinterpret_cast<iconv_t>(-1))
+            return -1;
+
+        const std::size_t limit = input.size() * bytesPerChar + 1;
+        resize(limit + 1, bufferAllocationPolicy, buffer);
+        char* inBuf = const_cast<char*>(input.data());
+        char* outBuf = buffer.data();
+        std::size_t inLeft = input.size();
+        std::size_t outLeft = limit;
+        const std::size_t result = iconv(cd, &inBuf, &inLeft, &outBuf, &outLeft);
+        iconv_close(cd);
+        if (result == static_cast<std::size_t>(-1))
+            return -1;
+
+        const std::size_t written = limit - outLeft;
+        buffer[written] = 0;
+        return static_cast<long>(written);
+    }
+#endif
