+#if defined(OPENMW_CJK_HAVE_ICU)
+    // Returns the number of bytes written to the buffer, or -1 when ICU cannot
+    // convert (unknown charset, malformed input).
+    long convertWithIcu(const char* toCode, const char* fromCode, std::string_view input,
+        BufferAllocationPolicy bufferAllocationPolicy, std::string& buffer)
+    {
+        UErrorCode status = U_ZERO_ERROR;
+        // A null destination makes ucnv_convert report the required capacity.
+        const int32_t capacity = ucnv_convert(
+            toCode, fromCode, nullptr, 0, input.data(), static_cast<int32_t>(input.size()), &status);
+        if (status != U_BUFFER_OVERFLOW_ERROR && U_FAILURE(status))
+            return -1;
+
+        status = U_ZERO_ERROR;
+        resize(static_cast<std::size_t>(capacity) + 1, bufferAllocationPolicy, buffer);
+        const int32_t written = ucnv_convert(toCode, fromCode, buffer.data(), capacity,
+            input.data(), static_cast<int32_t>(input.size()), &status);
+        if (U_FAILURE(status))
+            return -1;
+        buffer[written] = 0;
+        return written;
+    }
+#endif
