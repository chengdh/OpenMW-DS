+    std::size_t convertCjk(const char* toCode, const char* fromCode, std::string_view input,
+        BufferAllocationPolicy bufferAllocationPolicy, std::string& buffer, std::size_t bytesPerChar)
+    {
+        if (input.empty())
+        {
+            resize(1, bufferAllocationPolicy, buffer);
+            buffer[0] = 0;
+            return 0;
+        }
+
+#if defined(OPENMW_CJK_HAVE_ICU)
+        const long icuWritten
+            = convertWithIcu(toCode, fromCode, input, bufferAllocationPolicy, buffer);
+        if (icuWritten >= 0)
+            return static_cast<std::size_t>(icuWritten);
+#endif
+#if defined(OPENMW_CJK_HAVE_ICONV)
+        const long iconvWritten = convertWithIconv(
+            toCode, fromCode, input, bufferAllocationPolicy, buffer, bytesPerChar);
+        if (iconvWritten >= 0)
+            return static_cast<std::size_t>(iconvWritten);
+#endif
+        return copyRaw(input, bufferAllocationPolicy, buffer);
+    }
