+    std::size_t convertWithIconv(const char* toCode, const char* fromCode, std::string_view input,
+        BufferAllocationPolicy bufferAllocationPolicy, std::string& buffer, std::size_t bytesPerChar)
+    {
+        const std::size_t limit = input.size() * bytesPerChar + 1;
+#if defined(_WIN32) || defined(OPENMW_CJK_NO_ICONV)
+        (void)toCode;
+        (void)fromCode;
+#else
+        iconv_t cd = iconv_open(toCode, fromCode);
